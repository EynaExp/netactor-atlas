# NetActor Environment Variables

# Database
DATABASE_URL=sqlite+aiosqlite:///./netactor.db

# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Agent Settings
MAX_CONCURRENT_AGENTS=5
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7
